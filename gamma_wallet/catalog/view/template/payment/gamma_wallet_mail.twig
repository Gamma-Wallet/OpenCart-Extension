<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>{{ store_name }}</title></head>
<body style="margin:0;padding:24px;background:#f3f6f8;font-family:Arial,sans-serif;color:#1d2a33">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:12px">
    <tr><td style="padding:28px 28px 8px">
      <p style="margin:0 0 4px;font-size:14px;color:#5b6b76">{{ store_name }}</p>
      <p style="margin:0 0 16px;font-size:20px;font-weight:bold">{{ text_mail_title }}</p>
      <p style="margin:0 0 12px;font-size:15px;line-height:1.5">{{ text_mail_hello }}</p>
      <p style="margin:0 0 12px;font-size:15px;line-height:1.5">{{ text_mail_body }}</p>
    </td></tr>
    <tr><td style="padding:8px 28px 28px;text-align:center">
      <img src="{{ qr }}" width="200" height="200" alt="QR" style="display:block;margin:0 auto 14px">
      <a href="{{ link }}" style="color:#2e9bcc;font-weight:bold;font-size:15px">{{ text_open }}</a>
    </td></tr>
  </table>
</body></html>
